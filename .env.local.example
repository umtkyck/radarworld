# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Site
NEXT_PUBLIC_DOMAIN=http://localhost:3000

# NextAuth
AUTH_SECRET=
ADMIN_EMAIL=umtkyck@gmail.com
ADMIN_PASSWORD_SHA256=

# OAuth (optional — provider is disabled if credentials are missing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Firebase client SDK (public — used for future client features)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server — required for Firestore writes)
# Option A: paste the full service account JSON as a single line
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: individual fields from the service account key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
